graph LR
    START((START)) --> RECALL[recall]

    RECALL -->|"context > 40%?"| COMPACT_CHECK{should_compact_route}
    COMPACT_CHECK -->|"có"| COMPACT[compact]
    COMPACT_CHECK -->|"không"| AGENT[agent]
    COMPACT --> AGENT

    AGENT -->|"có tool call<br/>(interrupt_before HITL)"| TOOLS[tools]
    TOOLS -->|"kết quả tool"| AGENT
    AGENT -->|"không tool call"| STORE[store]

    STORE --> END((END))

    VSTORE[("Vector store<br/>Qdrant · user_memory")]
    RECALL -.->|"đọc theo user_id"| VSTORE
    STORE -.->|"ghi 1 fact mới"| VSTORE

    CKPT[("Checkpointer<br/>MemorySaver · thread_id")]
    RECALL -.-> CKPT
    COMPACT -.->|"RemoveMessage +<br/>summary (ghi đè)"| CKPT
    AGENT -.->|"append response"| CKPT

    classDef persist fill:#e3ede8,stroke:#2f5d4f,stroke-width:1.5px,color:#2f5d4f
    classDef ephemeral fill:#f0e2dc,stroke:#a8442e,stroke-width:1.5px,color:#a8442e
    classDef loop fill:#ffffff,stroke:#1c1b19,stroke-width:1.5px,color:#1c1b19
    classDef store fill:#e6ecf5,stroke:#3a5a8c,stroke-width:1.5px,color:#3a5a8c
    classDef terminal fill:#1c1b19,stroke:#1c1b19,color:#ffffff

    class RECALL,STORE persist
    class COMPACT persist
    class AGENT ephemeral
    class TOOLS loop
    class VSTORE,CKPT store
    class START,END terminal
